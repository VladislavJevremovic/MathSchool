---
import HomePage from "../../components/HomePage.astro";
import { languages, isLanguage } from "../../data/site";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang || "sr";
if (!isLanguage(lang)) throw new Error("Unsupported language");
---

<HomePage lang={lang} />
