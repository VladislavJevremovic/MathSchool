---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { copy, isLanguage, languages, type Language } from "../../data/site";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = (Astro.params.lang || "sr") as Language;
if (!isLanguage(lang)) throw new Error("Unsupported language");
const text = copy[lang];
---

<BaseLayout lang={lang} title={`${text.privacyTitle} | Jelena Jevremović`} description={text.privacyIntro}>
  <main id="main-content" class="page">
    <section class="card additional-program-page">
      <h1>{text.privacyTitle}</h1>
      <p>{text.privacyIntro}</p>
      <h2>{text.privacyDataTitle}</h2>
      <p>{text.privacyData}</p>
      <h2>{text.privacyUseTitle}</h2>
      <p>{text.privacyUse}</p>
      <h2>{text.privacyServicesTitle}</h2>
      <p>{text.privacyServices}</p>
      <p class="program-closing-note">{text.privacyContact}</p>
    </section>
  </main>
</BaseLayout>
